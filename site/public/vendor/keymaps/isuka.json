{
  "$schema": "../../../docs/keymap-v2.schema.json",
  "formatVersion": "2.0",
  "name": "いすか配列（仮称）",
  "description": "フリック入力の並びをキーボードに移した逐次打鍵のかな配列。左手＝子音の格子（テンキー面）、右手＝母音の十字（フリックの上下左右）。子音、母音の順に打つ。子音を押してから別の子音を押すと、前の子音は捨てられる。B＝゛゜小、T・Y・U＝カーソル左右と後退（日本語入力中だけ）。",
  "author": "msonrm",
  "targetScript": "hiragana",
  "base": "positional",
  "inputMappings": {
    "_comment_single": "単打",
    "k": "あ",
    "j": "い",
    "i": "う",
    ";": "え",
    "m": "お",
    "o": "ゃ",
    "l": "ゅ",
    ".": "ょ",
    "h": "ー",
    "n": "っ",
    "w": "ん",
    ",": "、",
    "/": "？",
    "_comment_unused": "空きキー（Q・A・Z・P）は何も入力しない。英字が出ると混乱するため",
    "q": "",
    "a": "",
    "z": "",
    "p": "",
    "_comment_repeat": "連打（逐次トライで表現）",
    ",,": "。",
    "//": "！",
    "ww": "を",
    "www": "んを",
    "_comment_rows": "子音→母音",
    "ek": "か",
    "ej": "き",
    "ei": "く",
    "e;": "け",
    "em": "こ",
    "rk": "さ",
    "rj": "し",
    "ri": "す",
    "r;": "せ",
    "rm": "そ",
    "sk": "た",
    "sj": "ち",
    "si": "つ",
    "s;": "て",
    "sm": "と",
    "dk": "な",
    "dj": "に",
    "di": "ぬ",
    "d;": "ね",
    "dm": "の",
    "fk": "は",
    "fj": "ひ",
    "fi": "ふ",
    "f;": "へ",
    "fm": "ほ",
    "xk": "ま",
    "xj": "み",
    "xi": "む",
    "x;": "め",
    "xm": "も",
    "vk": "ら",
    "vj": "り",
    "vi": "る",
    "v;": "れ",
    "vm": "ろ",
    "_comment_youon": "子音→ゃゅょ で拗音",
    "eo": "きゃ",
    "el": "きゅ",
    "e.": "きょ",
    "ro": "しゃ",
    "rl": "しゅ",
    "r.": "しょ",
    "so": "ちゃ",
    "sl": "ちゅ",
    "s.": "ちょ",
    "do": "にゃ",
    "dl": "にゅ",
    "d.": "にょ",
    "fo": "ひゃ",
    "fl": "ひゅ",
    "f.": "ひょ",
    "xo": "みゃ",
    "xl": "みゅ",
    "x.": "みょ",
    "vo": "りゃ",
    "vl": "りゅ",
    "v.": "りょ",
    "_comment_ya": "や行（い・えはカッコ）",
    "ck": "や",
    "ci": "ゆ",
    "cm": "よ",
    "cj": "「",
    "c;": "」",
    "_comment_wa": "わ行",
    "gk": "わ",
    "gj": "うぃ",
    "gi": "ゔ",
    "g;": "うぇ",
    "gm": "を"
  },
  "prefixShiftKeys": [
    "e",
    "r",
    "s",
    "d",
    "f",
    "g",
    "x",
    "c",
    "v"
  ],
  "behavior": {
    "type": "sequential",
    "unusedPrefix": "drop",
    "pendingLabels": {
      "_comment": "待っている子音を行の代表で見せる（表示だけ。ホストが薄く描く）",
      "e": "か",
      "r": "さ",
      "s": "た",
      "d": "な",
      "f": "は",
      "g": "わ",
      "x": "ま",
      "c": "や",
      "v": "ら"
    },
    "specialActions": {
      "_comment": "日本語入力中だけ効く（英字モードでは素の文字）。薙刀式の T = ← にならう",
      "t": "moveLeft",
      "y": "moveRight",
      "u": "deleteBack",
      "b": "postModify:cycle"
    },
    "characterMap": {}
  },
  "postModifyCycles": [
    "かが",
    "きぎ",
    "くぐ",
    "けげ",
    "こご",
    "さざ",
    "しじ",
    "すず",
    "せぜ",
    "そぞ",
    "ただ",
    "ちぢ",
    "つづ",
    "てで",
    "とど",
    "はばぱ",
    "ひびぴ",
    "ふぶぷ",
    "へべぺ",
    "ほぼぽ",
    "あぁ",
    "いぃ",
    "うぅゔ",
    "えぇ",
    "おぉ",
    "やゃ",
    "ゆゅ",
    "よょ",
    "わゎ"
  ],
  "postModifyYouon": "base",
  "requires": [
    "positionalBase",
    "unusedPrefix:drop",
    "postModify",
    "sequential:specialActions"
  ],
  "modeKeys": {
    "ctrl+space": "toggleInputMode",
    "ctrl+shift+j": "switchToJapanese",
    "ctrl+shift+semicolon": "switchToEnglish",
    "lang2": "switchToEnglish",
    "lang1": "switchToJapanese"
  }
}
